<footer class="border-t border-white/10 bg-black">
  <div class="mx-auto flex max-w-[90rem] flex-col gap-7 px-5 py-10 md:flex-row md:items-center md:justify-between lg:px-10">
    <div class="flex items-center gap-3">
      <%= image_tag "brand/logo.png", alt: "", class: "size-11 rounded-full object-cover" %>
      <span class="font-display font-black uppercase">Profe Axel</span>
    </div>
    <p class="text-xs text-slate-500">Entrenamiento personal · Presencial y online</p>
    <div class="flex items-center gap-5">
      <%= link_to instagram_url, target: "_blank", rel: "noopener noreferrer", class: "text-slate-400 transition hover:text-cyan-300", aria: { label: "Instagram de Profe Axel" } do %>
        <%= icon(:instagram, css_class: "size-5") %>
      <% end %>
      <%= link_to "Administrar contenido", new_admin_session_path, class: "text-xs font-bold uppercase tracking-[0.14em] text-slate-400 transition hover:text-cyan-300" %>
    </div>
  </div>
</footer>
