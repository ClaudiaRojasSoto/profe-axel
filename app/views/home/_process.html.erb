<section class="border-y border-white/10 bg-cyan-400 text-slate-950">
  <div class="mx-auto grid max-w-[90rem] divide-y divide-slate-950/15 md:grid-cols-3 md:divide-x md:divide-y-0">
    <% page.process_steps.each do |step| %>
      <article class="p-8 md:p-10 lg:p-14">
        <span class="text-xs font-black tracking-[0.18em]"><%= step.number %></span>
        <h3 class="font-display mt-12 text-3xl font-black uppercase"><%= step.title %></h3>
        <p class="mt-3 text-sm leading-6 text-slate-800"><%= step.summary %></p>
      </article>
    <% end %>
  </div>
</section>
