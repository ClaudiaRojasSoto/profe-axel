<section id="metodo" class="mx-auto max-w-[90rem] px-5 py-28 lg:px-10 lg:py-40">
  <div class="grid gap-12 lg:grid-cols-[0.85fr_1.15fr] lg:gap-24">
    <div>
      <span class="section-label">01 — El método</span>
      <h2 class="font-display mt-7 text-5xl font-black uppercase leading-[0.88] tracking-[-0.04em] md:text-7xl">
        No es solo
        <span class="block text-cyan-400">entrenar.</span>
        Es avanzar.
      </h2>
    </div>

    <div class="grid gap-px overflow-hidden rounded-2xl border border-white/10 bg-white/10">
      <% page.method_steps.each do |step| %>
        <article class="group grid gap-6 bg-[#0a0f15] p-7 transition hover:bg-[#101820] sm:grid-cols-[auto_1fr_auto] sm:items-center md:p-9">
          <span class="grid size-12 place-items-center rounded-xl border border-cyan-400/25 bg-cyan-400/10 text-cyan-300">
            <%= icon(step.icon, css_class: "size-5") %>
          </span>
          <div>
            <h3 class="font-display text-2xl font-black uppercase tracking-tight"><%= step.title %></h3>
            <p class="mt-2 max-w-xl text-sm leading-6 text-slate-400"><%= step.summary %></p>
          </div>
          <span class="font-display text-4xl font-black text-white/10 transition group-hover:text-cyan-400/50"><%= step.number %></span>
        </article>
      <% end %>
    </div>
  </div>
</section>
