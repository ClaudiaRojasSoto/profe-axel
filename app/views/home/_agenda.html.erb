<section id="agenda" class="relative">
  <div class="hero-grid absolute inset-0 opacity-20"></div>
  <div class="relative mx-auto grid max-w-[90rem] gap-16 px-5 py-28 lg:grid-cols-[0.8fr_1.2fr] lg:px-10 lg:py-40">
    <div class="flex h-full flex-col">
      <div>
        <span class="section-label">04 — Tu primer paso</span>
        <h2 class="font-display mt-7 text-6xl font-black uppercase leading-[0.83] tracking-[-0.05em] md:text-8xl">
          ¿Listo para
          <span class="block text-cyan-400">empezar?</span>
        </h2>
        <p class="mt-8 max-w-lg text-base leading-7 text-slate-300">
          Completa tus datos y Axel te contactará para conocer tu objetivo, resolver dudas y confirmar el mejor horario.
        </p>
        <div class="mt-10 grid gap-3">
          <%= link_to instagram_url, target: "_blank", rel: "noopener noreferrer", class: "flex w-fit items-center gap-3 text-sm font-bold text-slate-300 transition hover:text-cyan-300" do %>
            <%= icon(:instagram, css_class: "size-5") %>
            Hablar con Axel directamente
          <% end %>
          <p class="flex items-center gap-3 text-sm text-slate-400">
            <%= icon(:check, css_class: "size-5 text-cyan-400") %>
            Respuesta y confirmación personal
          </p>
        </div>
      </div>

      <div class="mt-16 overflow-hidden rounded-2xl border border-white/10 bg-white/[0.035] lg:mt-auto">
        <p class="border-b border-white/10 px-6 py-4 text-xs font-black uppercase tracking-[0.18em] text-cyan-300">¿Qué pasa después?</p>
        <% page.follow_up_steps.each do |step| %>
          <div class="flex items-center gap-5 border-b border-white/10 px-6 py-5 last:border-b-0">
            <span class="font-display text-2xl font-black text-white/20"><%= step.number %></span>
            <span class="text-sm font-bold text-slate-200"><%= step.title %></span>
          </div>
        <% end %>
      </div>
    </div>

    <% if notice.present? %>
      <%= render "home/success", message: notice %>
    <% else %>
      <%= render "home/form", page: page %>
    <% end %>
  </div>
</section>
